[Unit]
Description=XR Teleoperate Web Console
After=network-online.target can0.service
Wants=network-online.target can0.service

[Service]
Type=simple
User=robot
Group=robot
WorkingDirectory=@PROJECT_ROOT@
Environment=HOME=/home/robot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=XR_TELEOP_WEBRTC_SCHEME=https
Environment=XR_TELEOP_CERT=@PROJECT_ROOT@/config/cert.pem
Environment=XR_TELEOP_KEY=@PROJECT_ROOT@/config/key.pem
Environment=XR_TELEOP_DEFAULT_WEBRTC_SERVER_IP=192.168.60.182
Environment=XR_TELEOP_DEFAULT_IMAGE_SERVER_IP=192.168.123.5
Environment=XR_TELEOP_PYTHON=/home/robot/miniconda3/envs/teleop/bin/python3
Environment=XR_TELEOP_LEROBOT_PYTHON=/home/robot/miniconda3/envs/lerobot/bin/python
Environment=PATH=/home/robot/miniconda3/envs/teleop/bin:/home/robot/miniconda3/condabin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/robot/miniconda3/envs/teleop/bin/python3 -m teleop_web.server --host 0.0.0.0 --port 18099 --config config/web_console.json --log-dir logs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

StandardOutput=append:@PROJECT_ROOT@/logs/app/xr-teleop-web.service.log
StandardError=append:@PROJECT_ROOT@/logs/app/xr-teleop-web.service.log

[Install]
WantedBy=multi-user.target
