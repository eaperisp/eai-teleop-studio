[Unit]
Description=Dexterous Hand Debug Web Console
After=network-online.target inspire-dfx.service
Wants=network-online.target

[Service]
Type=simple
User=robot
Group=robot
WorkingDirectory=@PROJECT_ROOT@
Environment=HOME=/home/robot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=HAND_WEB_HOST=0.0.0.0
Environment=HAND_WEB_SCHEME=http
Environment=PATH=/home/robot/miniconda3/envs/teleop/bin:/home/robot/miniconda3/condabin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-@PROJECT_ROOT@/config/hand_web.env
ExecStart=/home/robot/miniconda3/envs/teleop/bin/python3 -m hand_web.server --host ${HAND_WEB_HOST} --port 18089 --config @PROJECT_ROOT@/hand_web/config.json --log-dir @PROJECT_ROOT@/logs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM

StandardOutput=append:@PROJECT_ROOT@/logs/app/hand-web.service.log
StandardError=append:@PROJECT_ROOT@/logs/app/hand-web.service.log

[Install]
WantedBy=multi-user.target
