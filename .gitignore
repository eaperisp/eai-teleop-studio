config/hand_web.env
config/cert.pem
config/key.pem
config/hand_web_ca.crt
config/hand_web_ca.key
config/hand_web_ca.srl
config/tls-backup-*/

# Runtime hand pose library
hand_web/poses.json
hand_web/poses.json.tmp
hand_web/vision_calibration.json
hand_web/vision_calibration.json.tmp
