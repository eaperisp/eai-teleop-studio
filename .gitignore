# Local hidden files/directories
.*

# Keep important repo hidden files if needed
!.gitignore
!.github/
!.gitmodules

# Python cache
__pycache__/
*.pyc

# IDE
.idea/

# Codex local temp files
.codex_*

# Runtime logs and process lock files
logs/

