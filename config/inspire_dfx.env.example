# DDS interface connected to the robot network.
DDS_IFACE=enp86s0

# Prefer /dev/serial/by-id, then /dev/serial/by-path, over /dev/ttyUSB0.
HAND_SERIAL=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0

# Official Unitree DFX serial-to-DDS bridge executable.
INSPIRE_DFX_SERVICE=/home/robot/DFX_inspire_service/build/inspire_h1

# Serial device IDs mapped to the DDS right/left channels. Set a missing side to 0.
# Official default: right=1, left=2. Example for one physical left hand using ID 1:
# INSPIRE_DFX_RIGHT_ID=0
# INSPIRE_DFX_LEFT_ID=1
INSPIRE_DFX_RIGHT_ID=1
INSPIRE_DFX_LEFT_ID=2
