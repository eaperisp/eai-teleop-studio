# Optional overrides for systemd/hand-web.service.
HAND_WEB_HOST=0.0.0.0
HAND_WEB_SCHEME=http
# The hand debug service is fixed to 18089; 18090 belongs to robot-sync-tool.

# Customer browser camera access requires a trusted HTTPS origin. Use
# scripts/setup_hand_web_lan_tls.sh for a closed LAN, or install a certificate
# issued by the customer's/public CA. Its SAN must match the browser URL. To
# enable HTTPS, change HAND_WEB_SCHEME above to https and uncomment both paths.
# HAND_WEB_CERT=/home/robot/eai-teleop-studio/config/cert.pem
# HAND_WEB_KEY=/home/robot/eai-teleop-studio/config/key.pem
